---
import IconPlay from "../../../public/assets/icon/IconPlay.astro";
import ButtonPrimary from "../../components/ButtonPrimary.astro";
import Animado from "./Animado.astro";
import PillSection from "../../components/PillSection.astro";
---

<section
  id="home"
  class="w-full max-w-480 grid grid-cols-2 min-h-max max-2xl:h-svh px-3 gap-3 xl:h-150"
>
  <div
    class="bg-[#F6F3EC] w-full h-full rounded-4xl flex flex-col justify-end xl:px-16 lg:px-6"
  >
    <header class="w-full mt-36">
      <!-- <PillSection name="PRESUPUESTO SIN CARGO EN 24HS" /> -->
      <div
        class="inline-flex items-center gap-1 bg-[#f5f0e8] rounded-full"
      >
        <!-- Avatars superpuestos -->
        <div class="flex items-center">
          <div
            class="size-8 rounded-full bg-gray-400 border-2 border-[#f5f0e8] relative z-30"
          >
          </div>
          <div
            class="size-8 rounded-full bg-gray-300 border-2 border-[#f5f0e8] -ml-3 relative z-20"
          >
          </div>
          <div
            class="size-8 rounded-full bg-gray-200 border-2 border-[#f5f0e8] -ml-3 relative z-10"
          >
          </div>
        </div>
        <!-- Texto -->
        <span class="text-base font-extrabold italic text-black"
          >+32 empresas confiaron en nosotros</span
        >
      </div>
      <Animado tipo="subir" delay={100}>
        <h1 class="2xl:text-[82px] text-2xl font-bold mb-8 text-primary-blue">
          Creando espacios <br />
          Construyendo <br />
          Confianza
        </h1>
      </Animado>
      <Animado tipo="subir" delay={300}>
        <h2 class="text-[20.5px] font-bold mb-6">
          Construcción y refacciones en todo <span
            class="font-extrabold text-primary-blue"
            >Buenos Aires
          </span>- Desde <span class="font-extrabold text-primary-blue"
            >Obras Completas
          </span><br /> hasta <span class="font-extrabold text-primary-blue">
            Reparaciones en tu Hogar</span
          >
        </h2>

        <p class="text-[19px] font-bold mb-14">
          Trabajamos con <span class="font-extrabold text-primary-blue"
            >Arquitectos y Propietarios directos</span
          > en todo tipo de proyectos.
        </p>
        <ButtonPrimary href="#obras-realizadas" text="Consultar sin Cargo " />
      </Animado>
    </header>
    <Animado tipo="derecha" delay={400} class="w-full">
      <footer class="w-full flex justify-between items-end mb-10">
        <p class="flex items-center gap-5 text-2xl font-medium">
          <span class="text-[64px] font-bold text-[#2C3E50]">20</span>
          <span class="w-[0.5px] h-20 bg-black inline-block"></span>
          Años de <br /> experiencia
        </p>
        <div
          class="w-58 h-32 flex justify-center items-center rounded-lg bg-[url(../assets/img/HeroVideo.jpeg)] bg-cover"
        >
          <IconPlay />
        </div>
      </footer>
    </Animado>
  </div>
  <Animado tipo="derecha" delay={500} class="w-full h-full">
    <div
      class="w-full h-full rounded-4xl bg-[url(../assets/img/HeroSection.jpeg)] bg-center bg-cover brightness-90"
    >
    </div>
  </Animado>
</section>
