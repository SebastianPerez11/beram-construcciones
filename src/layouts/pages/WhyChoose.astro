---
import IconShield from "../../../public/assets/icon/IconShield.astro";
import IconAttention from "../../../public/assets/icon/IconAttention.astro";
import PillSection from "../../components/PillSection.astro";
import IconEnterprise from "../../../public/assets/icon/IconEnterprise.astro";
import Animado from "./Animado.astro";
import PillWhyChoose from "../../components/PillWhyChoose.astro";
---

<section
  id="porque-elegirnos"
  class="flex flex-col h-max justify-between xl:py-36 lg:py-18 py-12 xl:w-306 w-3xl max-w-full px-3"
>
  <Animado tipo="subir" delay={0} class="w-full">
    <PillSection name="¿POR QUÉ ELEGIRNOS?" />
  </Animado>

  <div class="flex xl:flex-row flex-col w-full h-full gap-8">
    <Animado tipo="izquierda" delay={100} class="w-full">
      <div class="flex flex-col justify-end h-full w-full">
        <span
          class="md:h-175 h-120.5 xl:w-127 w-full rounded-4xl bg-[url(../assets/img/WhyChooseImage.jpg)] bg-center bg-cover relative"
        >
          <div class="h-full w-full rounded-4xl absolute bg-[#000921]/40"></div>
        </span>
      </div>
    </Animado>

    <div class="w-full flex flex-col">
      <Animado tipo="subir" delay={100}>
        <h2
          class="xl:w-full xl:text-7xl xl:leading-20 md:text-6xl md:w-[18ch] leading-12 text-[42px] font-bold lg:mb-8 mb-6"
        >
          Que nos diferencia de los demás
        </h2>
        <p class="font-extrabold md:text-xl text-lg mb-2 text-[#5D5D5D]">
          Nos especializamos en brindar soluciones constructivas integrales,
          combinando profesionalismo, eficiencia y compromiso.
        </p>
        <p class="font-bold text-lg mb-8 text-[#5D5D5D]">
          Cada proyecto refleja nuestro enfoque personalizado, orientado al
          detalle y al cumplimiento de plazos.
        </p>
      </Animado>

      <ul
        class="w-full flex flex-col items-center justify-between grow xl:gap-2 gap-8"
      >
        <Animado tipo="subir" class="w-full" delay={300}>
          <PillWhyChoose
            title="Empresa Responsable"
            parag="Cumplimos con todas las normativas vigentes y priorizamos la
              seguridad, sostenibilidad y transparencia en cada obra."
          >
            <slot slot="icon"><IconEnterprise /></slot>
          </PillWhyChoose>
        </Animado>

        <Animado tipo="subir" class="w-full flex" delay={400}>
          <li class="w-full flex">
            <span class="w-full h-px bg-[#5D5D5D] inline-block"></span>
          </li>
        </Animado>

        <Animado tipo="subir" class="w-full" delay={500}>
          <PillWhyChoose
            title="Calidad Garantizada"
            parag="Utilizamos materiales de primera línea y técnicas actualizadas
              para asegurar resultados duraderos."
          >
            <slot slot="icon"><IconShield /></slot>
          </PillWhyChoose>
        </Animado>

        <Animado tipo="subir" class="w-full flex" delay={600}>
          <li class="w-full flex">
            <span class="w-full h-px bg-[#5D5D5D] inline-block"></span>
          </li>
        </Animado>

        <Animado tipo="subir" class="w-full" delay={600}>
          <PillWhyChoose
            title="Atención Personalizada"
            parag="Acompañamos a nuestros clientes en todo el proceso, desde el
              diseño hasta la entrega final."
          >
            <slot slot="icon"><IconAttention /></slot>
          </PillWhyChoose>
        </Animado>
      </ul>
    </div>
  </div>
</section>
