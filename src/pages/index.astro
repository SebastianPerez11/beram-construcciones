---
import Layout from "../layouts/Layout.astro";
import NavBar from "../components/NavBar.astro";
import Home from "../layouts/pages/Home.astro";
import AboutUs from "../layouts/pages/AboutUs.astro";
import Services from "../layouts/pages/Services.astro";
import WhyChoose from "../layouts/pages/WhyChoose.astro";
import Proyects from "../layouts/pages/Proyects.astro";
import QuickConsult from "../layouts/pages/QuickConsult.astro";
import Footer from "../layouts/pages/Footer.astro";
import Animado from "../layouts/pages/Animado.astro";
---

<Layout>
  <NavBar />
  <main class="w-full flex flex-col items-center overflow-x-hidden">
    <Home />
    <AboutUs />
    <!-- <section id="historia" class="w-[1224px] flex-col h-max items-center py-0">
      <div class="flex flex-col justify-between w-full mb-17.5">
        <Animado tipo="subir" delay={100}>
          <h2 class="text-7xl font-bold leading-20 mb-6 text-center">
            Nuestra Historia
          </h2>
        </Animado>

        <Animado class="w-full" tipo="subir" delay={200}>
          <div class="w-full h-[480px] bg-blue-200 rounded-4xl"></div>
        </Animado>
      </div>
    </section> -->
    <Services />
    <WhyChoose />
    <Proyects />
    <QuickConsult />
    <Animado tipo="subir" class="w-full flex justify-center" delay={0}>
      <p
        class="xl:pb-36 lg:pb-18 pb-12 xl:text-4xl md:text-3xl text-xl font-bold italic text-center text-primary-blue xl:w-306 w-3xl max-w-full px-3"
      >
        “Especialistas en obras civiles, refacciones y construcciones llave en
        mano en Buenos Aires”
      </p>
    </Animado>

    <Footer />
  </main>
</Layout>
