---
import { services } from "../data/servicesData";
import Animado from "../layouts/pages/Animado.astro";

const service = services;
---

{
  service.map(({ description, service, features }) => (
    <Animado tipo="izquierda" delay={180}>
     
        <div class="flex w-[85vw] md:w-110 h-auto md:h-140 flex-col bg-white py-7 px-6 rounded-2xl">
        <header class="grow flex flex-col">
          <span class="size-12 bg-primary-blue rounded-xl block mb-6" />
          <h2 class="font-bold text-2xl mb-3">{service}</h2>
          <p class="text-lg font-semibold text-[#353535] grow">{description}</p>

          <ul class="text-lg ml-5 list-disc mb-14 text-[#000000]">
            {features.map((feature) => (
              <li> {feature} </li>
            ))}
          </ul>
        </header>

        <footer class="w-full flex flex-col">
          <div class="mb-10 text-sm font-bold flex justify-between items-center bg-[#E1E0FF] px-3 py-5 ">
            {/* <span class="text-xs">DESDE</span>
            <span>{measure}</span> */}
          </div>
          <div class="w-full flex flex-col gap-2">
            <a
              class="bg-primary-blue border-blue-950 py-2 w-full text-center text-white font-extrabold"
              href=""
            >
              Solicitar Presupuesto
            </a>
            <a
              class="border-blue-950 border-2 py-2 w-full text-center text-blue-primary font-bold"
              href=""
            >
              Ver Más Información
            </a>
          </div>
        </footer>
      </div>
    </Animado>
  ))
}
