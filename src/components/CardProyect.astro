---
import IconLocation from "../../public/assets/icon/IconLocation.astro";
import { proyects } from "../data/proyectsData";

const allProyects = proyects;
---

<div class="stack-cards-wrapper flex flex-col gap-4">
    {
        allProyects.map(
            (
                {
                    titleProyect,
                    subtitle,
                    description,
                    location,
                    status,
                    bgImage,
                },
                index,
            ) => (
                <div class="stack-card-slot" data-card-slot={index}>
                    <section
                        class={`stack-card relative w-full h-150 rounded-4xl flex justify-end items-center ${bgImage} bg-cover bg-center px-3`}
                        data-stack-index={index}
                    >
                        {/* Overlay solo sobre el fondo */}
                        <div class="absolute inset-0 rounded-4xl bg-black/25 pointer-events-none" />

                        {/* Card por encima del overlay */}
                        <div class="card-content relative z-10 bg-white py-6 md:px-12 px-3 w-135 md:h-95 md:max-h-none max-h-fit mr-0 md:mr-10 xl:mr-22 rounded-4xl flex flex-col justify-center shadow-2xl">
                            <header class="mb-6">
                                <h1 class="lg:text-4xl text-3xl font-extrabold mb-5">
                                    {titleProyect}
                                </h1>
                                <p class="mb-2 text-xl font-bold">{subtitle}</p>
                                <p class="mb-2 text-xl font-semibold text-[#5D5D5D] text-pretty">
                                    {description}
                                </p>
                            </header>
                            <footer class="flex md:flex-row flex-col justify-between gap-6 md:items-center h-max">
                                <span class="font-bold text-primary-blue text-lg flex w-full items-center gap-1">
                                    <IconLocation /> {location}
                                </span>
                                <span class="font-extrabold text-sm bg-primary-blue text-white py-3 px-6 rounded-full">
                                    {status}
                                </span>
                            </footer>
                        </div>
                    </section>
                </div>
            ),
        )
    }
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const slots = Array.from(
            document.querySelectorAll("[data-card-slot]"),
        ) as HTMLElement[];

        slots.forEach((slot, index) => {
            const card = slot.querySelector(".stack-card") as HTMLElement;
            if (!card) return;

            // Configuración sticky
            card.style.position = "sticky";
            card.style.top = `${100 + index * 40}px`;
            card.style.zIndex = (slots.length - index).toString();
            card.style.transition = "all 0.6s cubic-bezier(0.4, 0, 0.2, 1)";

            // Estado inicial
            const initialScale = 1 - index * 0.05;
            card.style.transform = `scale(${initialScale})`;
            card.style.opacity = "0.6";

            // Observer
            const observer = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting) {
                            card.style.transform = "scale(1)";
                            card.style.opacity = "1";
                        } else {
                            const initialScale = 1 - index * 0.05;
                            card.style.transform = `scale(${initialScale})`;
                            card.style.opacity = "0.6";
                        }
                    });
                },
                {
                    threshold: 0.5,
                    rootMargin: "-100px 0px",
                },
            );

            observer.observe(slot);
        });
    });
</script>

<style>
    .stack-cards-wrapper {
        position: relative;
        width: 100%;
        height: max-content;
    }

    .stack-card-slot {
        height: 100%;
        position: relative;
    }

    .card-content {
        transform-origin: center;
        transition: transform 0.3s ease;
    }

    .stack-card:hover .card-content {
        transform: translateY(-10px);
    }
</style>
